# ==============================================================================
# RH2.0 — Arquivo Modelo de Variáveis de Ambiente (.env.example)
# Arquitetura Oficial: Node.js + NestJS | PostgreSQL | React + TypeScript
# ==============================================================================
# NUNCA versione o arquivo '.env' real com credenciais reais de produção.
# ==============================================================================

# --- SERVIDOR HTTP (NestJS) ---
PORT=8000
NODE_ENV=development

# --- BANCO DE DADOS OPERACIONAL (PostgreSQL) ---
# OBRIGATÓRIO em ambiente operacional (produção, homologação ou desenvolvimento real).
# Formato padrão PostgreSQL / Supabase:
# postgresql://<usuario>:<senha>@<host>:<porta>/<banco>?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rh20_db

# Habilitar SSL para conexões de nuvem gerenciada (Supabase, AWS RDS, Neon, etc.)
# Valores: true | false
DB_SSL=false

# --- AUTENTICAÇÃO E PROVISIONAMENTO INICIAL ---
# Senha forte inicial obrigatória para o usuário administrador operacional (admin.dp@empresa.com.br)
# Requisito de complexidade: mínimo 12 caracteres, maiúsculas, minúsculas, números e caracteres especiais.
ADMIN_INITIAL_PASSWORD=TroqueEstaSenhaImediatamente#2026!

# --- SEGURANÇA E CORS (Cross-Origin Resource Sharing) ---
# Lista de origens autorizadas separadas por vírgula. Sem barras no final.
# NUNCA utilize origens coringa (*) em produção quando credenciais estão habilitadas.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- POLÍTICA DE SESSÕES ---
# As sessões utilizam tokens criptograficamente seguros de 32 bytes (256 bits).
# Os tokens trafegam exclusivamente via cookies com flag HttpOnly, SameSite=Lax (e Secure em HTTPS).
# O banco de dados armazena apenas o hash criptográfico SHA-256 do token para proteção contra vazamento.
# Duração padrão da sessão: 12 horas com renovação de identificador e auditoria centralizada.
